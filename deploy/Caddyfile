# İki rejim (deploy/.env ilə seçilir):
#  1) Birbaşa (defolt): Caddy 80/443-də dinləyir, HTTPS sertifikatını özü alır.
#  2) Mövcud nginx/proxy arxasında: WEB_SITE=http://… API_SITE=http://…,
#     Caddy yalnız daxildə HTTP verir, HTTPS-i qarşıdakı proxy edir
#     (bax: deploy/nginx-existing-proxy.conf, docker-compose.edge.yml).
#  3) Cloudflare Tunnel: docker-compose.tunnel.yml (HTTPS-i Cloudflare edir).
{
	# ACME e-poçtu məcburi deyil (boş olanda Caddy açılmırdı) — yalnız birbaşa
	# rejimdə Let's Encrypt bildirişləri üçün istəyə görə: ACME_EMAIL=… (.env)
	{$CADDY_ACME_EMAIL_LINE}
	servers {
		# Yalnız bu ünvanlardan gələn X-Forwarded-For-a etibar olunur; qalanlarda
		# Caddy başlığı istifadəçinin həqiqi IP-si ilə ƏVƏZ edir (saxtalaşdırma olmur).
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		# Etibarlı proxy-dən gələndə istifadəçi IP-si hansı başlıqdan oxunsun.
		# Cloudflare Tunnel: Cf-Connecting-Ip (Cloudflare özü yazır, saxtalaşdırılmır).
		client_ip_headers {$CLIENT_IP_HEADER:X-Forwarded-For}
	}
}

# ── API: api.ellit.az → Python backend ──
{$API_SITE} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}
	# WebSocket (/realtime/v1/websocket, /ws) avtomatik ötürülür
	reverse_proxy api:8000 {
		health_uri /health
		health_interval 5s
		# API yenidən başlayanda (docker compose up -d api) sorğu dərhal 502
		# almasın: Caddy backend hazır olana qədər 20 san. gözləyib təkrar yoxlayır
		# (yalnız bağlantı qurulmayanda — gövdəsi göndərilmiş sorğu təkrarlanmır)
		lb_try_duration 20s
		lb_try_interval 250ms
		# Backend-ə yalnız müəyyən edilmiş həqiqi IP ötürülür (zəncir yox) —
		# istifadəçinin göndərdiyi saxta X-Forwarded-For heç vaxt çatmır
		header_up X-Forwarded-For {client_ip}
	}
}

# ── Veb sayt: ellit.az ──
{$WEB_SITE} {
	encode zstd gzip
	root * /srv
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
