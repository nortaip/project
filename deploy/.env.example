# ═══ Ellit production ayarları — serverdə: cp .env.example .env && nano .env ═══
# Bu fayl git-ə DÜŞMÜR (.gitignore). İcazə: chmod 600 .env

# ── Domenlər (hər ikisinin DNS A qeydi serverin IP-sinə yönəlməlidir) ──
WEB_DOMAIN=ellit.az
API_DOMAIN=api.ellit.az
# Let's Encrypt bildirişləri üçün
ACME_EMAIL=admin@ellit.az

# ── Sirlər — güclü təsadüfi dəyərlər: openssl rand -hex 32 ──
POSTGRES_PASSWORD=
JWT_SECRET=

# ── E-poçt (parol bərpası) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ellit <no-reply@ellit.az>
SMTP_SECURITY=starttls

# ── Google / Apple girişi ──
# Mobil (native) Google girişi üçün: web,ios,android client id-ləri, vergüllə
GOOGLE_CLIENT_IDS=
# Veb Google girişi: veb OAuth klienti (Google Console-da redirect:
# https://api.ellit.az/auth/v1/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_BUNDLE_ID=asif.dev.ellit.booking
# Veb Apple girişi: Services ID (Apple Developer → Identifiers → Services IDs;
# Return URL: https://api.ellit.az/auth/v1/callback)
APPLE_SERVICE_ID=
# client_secret avtomatik imzalanır: Team ID + Key ID + .p8 açarı
# (açarı deploy/secrets/apple.p8 kimi qoyun)
APPLE_TEAM_ID=
APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=/run/secrets/ellit/apple.p8
# .p8 yoxdursa: Supabase → Auth → Apple-dakı hazır "Secret Key (for OAuth)" JWT
# (ən çox 6 ay etibarlıdır, sonra yenisi lazımdır)
# APPLE_CLIENT_SECRET=
AUTH_REDIRECT_URLS=https://ellit.az/*,https://www.ellit.az/*,io.supabase.ellitbooking://login-callback/

# ── Ödəniş (Epoint) ──
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=

# ── Push bildirişləri (Firebase) — service-account JSON-u deploy/secrets/firebase.json kimi qoyun ──
FIREBASE_CREDENTIALS_PATH=/run/secrets/ellit/firebase.json

# ── Cloudflare Tunnel ilə (port açmadan; HTTPS-i Cloudflare edir) ──
# COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml
# CLOUDFLARE_TUNNEL_TOKEN=
# WEB_SITE="http://ellit.az, http://www.ellit.az"   # bir neçə ünvan: vergül + boşluq, dırnaqda
# API_SITE=http://api.ellit.az
# TRUSTED_PROXIES=private_ranges
# CLIENT_IP_HEADER=Cf-Connecting-Ip

# ── Serverdə 80/443-ü artıq BAŞQA Docker Caddy/nginx tutursa (ortaq "edge" şəbəkəsi) ──
# COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# WEB_SITE=http://ellit.az
# API_SITE=http://api.ellit.az
# TRUSTED_PROXIES=private_ranges

# ── Serverdə 80/443-ü host-da quraşdırılmış nginx tutursa ──
# Aşağıdakıları açın; HTTPS-i mövcud nginx edir (deploy/nginx-existing-proxy.conf):
# WEB_SITE=http://ellit.az
# API_SITE=http://api.ellit.az
# HTTP_BIND=127.0.0.1:8088
# HTTPS_BIND=127.0.0.1:8443
# TRUSTED_PROXIES=private_ranges

# ── API ──
API_WORKERS=2
