ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://ellit:ellit@db:5432/ellit
REDIS_URL=redis://redis:6379/0

# ── SSH tuneli: PostgreSQL başqa serverdədirsə doldurun ──
# Dolu olanda DATABASE_URL-dəki host/port SSH SERVERİNDƏN görünən ünvandır
# (adətən 127.0.0.1:5432). Boş qalsa tunel açılmır.
# Yoxlama:  python -m app.db.tunnel --fingerprint   →   python -m app.db.tunnel
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=
SSH_PASSWORD=
SSH_HOST_FINGERPRINT=
SSH_KNOWN_HOSTS=

# ── E-poçt (parol bərpası kodu). Boşdursa kod yalnız tətbiq bildirişi ilə gedir ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ellit <no-reply@ellit.az>
SMTP_SECURITY=starttls
JWT_SECRET=GUCLU_64_BAYTLIQ_SIRR_YAZIN
GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,ios-client-id.apps.googleusercontent.com
APPLE_BUNDLE_ID=asif.dev.ellit.booking
APPLE_SERVICE_ID=
CORS_ORIGINS=https://ellit.az,http://localhost:5173
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ellit
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=

# ── Supabase-uyğun giriş qatı (/auth/v1, /rest/v1, /storage/v1, /realtime/v1) ──
# Veb saytın ünvanı (parol bərpası keçidləri və OAuth qayıdışı üçün)
SITE_URL=https://ellit.az
# Bu backend-in xaricdən görünən ünvanı (Google OAuth redirect_uri, e-poçt keçidləri)
API_EXTERNAL_URL=https://api.ellit.az
# OAuth/parol bərpasından sonra qayıtmağa icazə verilən ünvanlar (vergüllə; sonu * prefiks deməkdir)
AUTH_REDIRECT_URLS=https://ellit.az/*,io.supabase.ellitbooking://login-callback/
# Google veb OAuth klienti (Google Console-da redirect: https://api.ellit.az/auth/v1/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Fayllar (Supabase Storage əvəzi) — daimi disk, backup-a daxil edin
STORAGE_DIR=/var/lib/ellit/storage
